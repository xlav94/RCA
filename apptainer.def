Bootstrap: Docker
From: python:3.13-slim

%post
    apt-get update && apt-get install -y \
        gcc \
        g++ \
        libopenblas-dev \
        liblapack-dev \
        gfortran \
        make \
        pkg-config

    pip install --upgrade pip
    pip install -r requirements.txt

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PYTHONUNBUFFERED=1

%runscript
    exec python "$@"
